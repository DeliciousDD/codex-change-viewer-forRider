{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|exec",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/hooks/authorize_apply_patch.ps1\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
